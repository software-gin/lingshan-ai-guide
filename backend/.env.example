# ============================================================
# 环境变量模板：复制为 backend/.env 后填入实际值
# （本地真实密钥建议放 backend/.env.local，已被 .gitignore 排除）
# 所有项均可选 —— 未配置时对应能力自动降级或关闭
# ============================================================

# ---------- 密钥类（请勿提交真实值到 git） ----------
SECRET_KEY=
LLM_API_KEY=
HF_TOKEN=
MAP_KEY=
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
DEFAULT_ADMIN_PASSWORD=

# ---------- 大模型（通义千问 Qwen，DashScope 兼容 OpenAI 协议） ----------
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.5-omni-flash
LLM_VISION_MODEL=qwen3.5-omni-flash
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# ---------- 可观测性（缺省关闭） ----------
# LANGFUSE_ENABLED=false
# LANGFUSE_HOST=https://cloud.langfuse.com
# SENTRY_DSN=（留空即禁用 Sentry）

# ---------- Flask 运行 ----------
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5001
# FLASK_DEBUG=false
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ---------- HuggingFace / 嵌入 ----------
# HF_ENDPOINT=https://hf-mirror.com
# EMBEDDING_MODEL_PATH=shibing624/text2vec-base-chinese

# ---------- 语音 ----------
# WHISPER_MODEL_SIZE=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---------- 检索 / 图谱 / 精排 ----------
# CHROMA_TOP_K=5
# GRAPH_ENHANCED_RAG=true
# GRAPH_MAX_HOPS=1
# GRAPH_TOP_K=5
# RERANK_ENABLED=true
# RERANK_MODEL=BAAI/bge-reranker-base

# ---------- 3D 数字人（LiveTalking，缺省关闭可不用） ----------
# LIVETALKING_ENABLED=false
# LIVETALKING_API_URL=http://localhost:8010